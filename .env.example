# Copy to .env and keep it private. Values below are examples only.
TIMEZONE=Asia/Shanghai
CRON_DAY_OF_WEEK=mon
CRON_HOUR=9
CRON_MINUTE=0
RUN_ON_STARTUP=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_SUBJECT_PREFIX=[BIS Working Papers]
MAIL_ON_EMPTY=false
SITE_TITLE=BIS Working Papers Monitor
PUBLIC_URL=
ADMIN_TOKEN=
# Set DATA_DIR to an existing persistent volume in production; omit it locally.
# DATA_DIR=/data
# Set these for GitHub Actions delivery; configure its secrets separately.
EXTERNAL_MAILER=false
GITHUB_REPO=
FETCH_DELAY_MS=400
BACKFILL_RECENT=60
MAX_DETAIL_FETCH=120
MIN_BASELINE_PAPERS=500
MIN_LIST_RATIO=0.9
